# Copia este archivo a .env y rellénalo. Nunca lo subas a git.

# Flex Web Service (Portal IBKR → Informes → Flex Queries → Configuración de Flex Web Service)
IB_FLEX_TOKEN=
IB_FLEX_QUERY_ID=

# Email (alerts.channel: email). Con Gmail: contraseña de aplicación, ver README
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Telegram (alerts.channel: telegram). Ver README, sección "Crear el bot"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
